# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Public assets
/public/*
!/public/dms-mark.svg

# Local planning, design, and agent guidance. These files must never be committed.
/AGENTS.md
/ROADMAP.md
/DESIGN-DIRECTION.md
/SCREEN-DESIGN.md
/docs/DESIGN*.md
/docs/templates/
