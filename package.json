{
  "name": "dms-demo",
  "version": "0.1.0",
  "private": true,
  "description": "A public portfolio demo of a dental practice operations workspace.",
  "homepage": "https://dms-demo-seven.vercel.app",
  "bugs": {
    "url": "https://github.com/acevedo-daniel/dms-demo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acevedo-daniel/dms-demo.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "test": "vitest run",
    "test:integration": "pnpm db:migrate:integration && vitest run --config vitest.integration.config.mts",
    "test:e2e": "pnpm db:migrate:integration && pnpm db:seed:integration && playwright test",
    "db:migrate:integration": "tsx scripts/db/migrate-integration.ts",
    "db:seed:integration": "tsx scripts/db/seed-integration.ts",
    "db:test:up": "docker compose -f compose.test.yaml up -d --wait",
    "db:test:down": "docker compose -f compose.test.yaml down",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:reset": "pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
