# Application (use the canonical public URL in deployed environments)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL (Docker Compose defaults)
POSTGRES_DB="dms_demo"
POSTGRES_USER="dms"
POSTGRES_PASSWORD="dms"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://dms:dms@localhost:5432/dms_demo"

# PostgreSQL integration tests (use only the isolated dms_test database)
TEST_DATABASE_URL="postgresql://dms_test:dms_test@localhost:5434/dms_test"

# Authentication
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-32-character-minimum-secret"
DEMO_AUTH_EMAIL="demo-admin@dms.invalid"
DEMO_AUTH_PASSWORD="replace-with-a-random-server-only-demo-password"

# End-to-end tests
PLAYWRIGHT_BASE_URL="http://localhost:3100"
